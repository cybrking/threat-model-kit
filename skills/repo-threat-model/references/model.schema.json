{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 0
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      },
      "minItems": 0
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      },
      "minItems": 0
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "minItems": 0
    },
    "threats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/threat"
      },
      "minItems": 0
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "scope",
    "assets",
    "actors",
    "components",
    "boundaries",
    "flows",
    "invariants",
    "evidence",
    "assumptions",
    "threats",
    "controls",
    "checks",
    "coverage"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "area": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "area",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "privacy",
              "ai",
              "critical",
              "quantitative"
            ]
          },
          "uniqueItems": true
        },
        "risk_policy": {
          "type": "string",
          "minLength": 1
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "location",
              "revision",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "aws_access": {
          "type": "object",
          "properties": {
            "read_only": {
              "const": true
            },
            "status": {
              "enum": [
                "available",
                "partial",
                "denied",
                "not_requested"
              ]
            },
            "identity_ref": {
              "type": "string",
              "minLength": 1
            },
            "accounts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "collected_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "visibility_gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "read_only",
            "status",
            "identity_ref",
            "accounts",
            "regions",
            "collected_at",
            "visibility_gaps"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "ticket",
                  "feature",
                  "idea",
                  "design"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "locator",
              "revision",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "purpose",
        "snapshot",
        "environment",
        "owner",
        "in_scope",
        "exclusions",
        "profiles",
        "risk_policy",
        "repositories"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "repositories": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "harm": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "description",
        "owner",
        "harm"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "description",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "description",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from_component_id": {
          "type": "string",
          "minLength": 1
        },
        "to_component_id": {
          "type": "string",
          "minLength": 1
        },
        "boundary_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "from_component_id",
        "to_component_id",
        "boundary_ids",
        "data",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "invariant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "statement",
        "asset_ids"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "code",
            "config",
            "design",
            "runtime",
            "test",
            "external"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "locator",
        "snapshot",
        "observation"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "verification_plan": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "statement",
        "owner",
        "verification_plan"
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "impact": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "feasibility": {
          "enum": [
            "demonstrated",
            "plausible",
            "unlikely",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "residual_risk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "impact",
        "feasibility",
        "confidence",
        "priority",
        "rationale",
        "residual_risk"
      ],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "authorized_owner": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "authorized_owner",
        "rationale",
        "review_date"
      ],
      "additionalProperties": false
    },
    "threat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "hypothesis",
            "confirmed",
            "mitigated",
            "accepted",
            "dismissed"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "entry_component_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "boundary_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "invariant_id": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attack_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "harm": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assumption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "response": {
          "enum": [
            "avoid",
            "reduce",
            "transfer",
            "accept",
            "investigate"
          ]
        },
        "control_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "disposition_reason": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "actor_id",
        "entry_component_id",
        "asset_ids",
        "boundary_ids",
        "invariant_id",
        "prerequisites",
        "attack_steps",
        "harm",
        "tags",
        "evidence_ids",
        "assumption_ids",
        "risk",
        "response",
        "control_ids",
        "owner",
        "next_action",
        "due_date"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "implemented"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "requirement",
        "status",
        "evidence_ids",
        "check_ids",
        "owner"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_run"
          ]
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "control_id",
        "procedure",
        "expected",
        "outcome",
        "snapshot",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "lens": {
          "enum": [
            "security",
            "privacy",
            "business_abuse",
            "operations",
            "ai"
          ]
        },
        "disposition": {
          "enum": [
            "reviewed",
            "not_applicable",
            "deferred"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "threat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "boundary_id",
        "lens",
        "disposition",
        "rationale",
        "threat_ids"
      ],
      "additionalProperties": false
    }
  },
  "title": "Agent-readable threat model draft 0.2"
}
